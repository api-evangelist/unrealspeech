          "request": {
            "name": "Stream synthesized audio (low latency)",
            "description": {
              "content": "Converts up to 1,000 characters of text into speech and streams the audio bytes back in the HTTP response (chunked transfer), typically in around 0.3 seconds. Intended for time-sensitive uses such as chatbots and voice agents. This is HTTP response streaming, not a WebSocket.",
              "type": "text/plain"
            },
