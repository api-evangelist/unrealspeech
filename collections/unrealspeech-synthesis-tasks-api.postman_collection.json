          "name": "Create an asynchronous synthesis task",
          "request": {
            "name": "Create an asynchronous synthesis task",
            "description": {
              "content": "Submits up to 500,000 characters of text for asynchronous synthesis and immediately returns a TaskId. Optimized for long-form audio such as audiobooks and articles. Provide an optional CallbackUrl to be notified of status changes.",
              "type": "text/plain"
            },
            "url": {
