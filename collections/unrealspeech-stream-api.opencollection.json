{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unreal Speech Stream API",
    "version": "v7"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Stream",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Stream synthesized audio (low latency)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.v7.unrealspeech.com/stream",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Converts up to 1,000 characters of text into speech and streams the audio bytes back in the HTTP response (chunked transfer), typically in around 0.3 seconds. Intended for time-sensitive uses such as chatbots and voice agents. This is HTTP response streaming, not a WebSocket."
        }
      ]
    }
  ],
  "bundled": true
}